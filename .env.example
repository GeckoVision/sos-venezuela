# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# LLM provider: openrouter (free, default) | anthropic
SOSBOT_PROVIDER=openrouter

# If SOSBOT_PROVIDER=openrouter
OPENROUTER_API_KEY=

# If SOSBOT_PROVIDER=anthropic  (more reliable tool-calling, ~$0.005/chat — use for judging)
ANTHROPIC_API_KEY=

# Optional
# SOSBOT_MODEL=            # override the default model id
# SOSBOT_MODE=live         # "live" (real API) or "recorded" ($0 offline, synthesized)

# Usage telemetry (optional). Set to the same MongoDB connection string the hosted
# MCP uses (points at the gecko_events DB) to feed the correctness-flywheel with
# control-plane-safe metadata (tool name, ok, latency — never args or payloads).
# Unset = silent no-op (a plain install never phones home). GECKO_TELEMETRY=off disables.
# MONGODB_URI=
